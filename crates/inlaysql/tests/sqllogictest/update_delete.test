# UPDATE and DELETE, with WHERE filters and expressions on the right-hand side.

statement ok
CREATE TABLE t(a INTEGER, b INTEGER)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)

statement ok
UPDATE t SET b = b + 1 WHERE a >= 2

query II rowsort
SELECT a, b FROM t
----
1 10
2 21
3 31

statement ok
UPDATE t SET a = 99 WHERE a = 1

query I nosort
SELECT a FROM t ORDER BY a
----
2
3
99

statement ok
DELETE FROM t WHERE a = 2

query I nosort
SELECT a FROM t ORDER BY a
----
3
99

statement ok
DELETE FROM t

query I
SELECT a FROM t
----

# ---------------------------------------------- qualified columns (AHL-475)
#
# A qualified column on the left of `SET` is refused, in every shape, checked
# directly against a real `sqlite3` binary rather than assumed: `sqlite3`
# itself treats it as a syntax error, right table name, wrong table, or an
# alias — a compound assignment target has no meaning in its `UPDATE`
# grammar at all. A qualified column everywhere *else* in an `UPDATE` or
# `DELETE` — `WHERE`, an expression on the right of `SET` — already works,
# because those resolve through the ordinary column-reference path rather
# than the raw assignment target sqlparser hands the planner. See
# `unsupported.test` for the same refusal pinned as a regression test, and
# `crates/inlaysql-server`'s `mysqlddl::update_set` for where a MySQL client's
# own `t.col = ?` (real syntax there, and what Eloquent writes on every save
# of a model with timestamps) is rewritten before it ever reaches this
# parser.

statement ok
CREATE TABLE u(a INTEGER, b INTEGER)

statement ok
CREATE TABLE other(a INTEGER)

statement ok
INSERT INTO u VALUES (1, 10), (2, 20), (3, 30)

# Qualified SET target, qualifier names the statement's own table — still a
# syntax error to `sqlite3`.
statement error
UPDATE u SET u.b = b + 1 WHERE a >= 2

# A bare assignment beside a qualified one in the same statement — the exact
# shape Eloquent compiles for a model save with timestamps.
statement error
UPDATE u SET a = 5, u.b = 10 WHERE a = 1

# Qualifier names a different, real table.
statement error
UPDATE u SET other.b = 10 WHERE a = 1

# An aliased target: `sqlite3` refuses the qualified assignment before it
# would even reach the question of whether the alias resolves.
statement error
UPDATE u AS x SET x.b = 5 WHERE x.a = 1

# A qualified column in `WHERE`, alongside an ordinary unqualified `SET` —
# this is not the gap AHL-475 closes, and it already worked: `WHERE` resolves
# through the same column-reference path a `SELECT` uses.
statement ok
UPDATE u SET b = 5 WHERE u.a = 1

query II nosort
SELECT a, b FROM u ORDER BY a
----
1 5
2 20
3 30

# `DELETE ... WHERE` and `RETURNING` resolve a qualified column the same way.
statement ok
DELETE FROM u WHERE u.a = 2

query I nosort
SELECT a FROM u ORDER BY a
----
1
3

query II nosort
UPDATE u SET b = 9 WHERE u.a = 1 RETURNING u.a, u.b
----
1 9

query II nosort
SELECT a, b FROM u ORDER BY a
----
1 9
3 30
