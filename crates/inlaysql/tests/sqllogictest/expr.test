# Scalar expressions in the projection and WHERE of a FROM query.

statement ok
CREATE TABLE nums(a INTEGER, b INTEGER)

statement ok
INSERT INTO nums VALUES (1, 10), (2, 20), (3, 30)

query I rowsort
SELECT a + b FROM nums
----
11
22
33

query I nosort
SELECT a - b FROM nums ORDER BY a
----
-9
-18
-27

query I rowsort
SELECT a * 2 FROM nums WHERE a >= 2
----
4
6

query I nosort
SELECT a FROM nums WHERE a + 1 > 2 ORDER BY a
----
2
3

query I rowsort
SELECT a FROM nums WHERE a > 1 AND b < 30
----
2

query I rowsort
SELECT a FROM nums WHERE a = 1 OR b = 30
----
1
3

# ------------------------------------------------- mixed storage classes (AHL-477)

# `eval.rs::comparison` used to raise `Error::Type` for a pair that crossed
# SQLite's storage classes (NULL excepted, which is three-valued logic's
# business and handled earlier) — an INTEGER against a TEXT, say. SQLite
# never errors there: every value belongs to exactly one of NULL < numbers <
# TEXT < BLOB, and a comparison between classes answers by that fixed order.
# Every result below came from a real sqlite3 3.54 binary.
query I nosort
SELECT 1 < 'a'
----
1

query I nosort
SELECT 1 > 'a'
----
0

query I nosort
SELECT 1 = 'a'
----
0

query I nosort
SELECT 'a' < X'61'
----
1

query I nosort
SELECT 'a' > X'61'
----
0

query I nosort
SELECT 1.5 < X'0102'
----
1

# `NULL` still owns three-valued logic — a cross-class pair does not make a
# `NULL` operand into a class-order verdict.
query I nosort
SELECT (NULL < 1) IS NULL
----
1

query I nosort
SELECT (NULL = 1) IS NULL
----
1

# The same rule filtering real rows, not just scalar literals: a `NUMERIC`
# column holding every class, filtered by a literal from a different class.
statement ok
CREATE TABLE mixed_where(v NUMERIC)

statement ok
INSERT INTO mixed_where VALUES (NULL), (2), (1), ('xyz'), (X'0304'), (1.5), (2)

# `v > 1`: every number greater than 1, plus every TEXT and BLOB (both
# classes rank above numbers); `1` itself and `NULL` are excluded.
query R nosort
SELECT v FROM mixed_where WHERE v > 1 ORDER BY v LIMIT 1 OFFSET 0
----
1.5

query T nosort
SELECT v FROM mixed_where WHERE v > 1 ORDER BY v LIMIT 1 OFFSET 3
----
xyz

query T nosort
SELECT v FROM mixed_where WHERE v > 1 ORDER BY v LIMIT 1 OFFSET 4
----
<blob>

# `v < 'xyz'`: every number (numbers rank below TEXT), and neither `'xyz'`
# itself nor the BLOB (BLOB ranks above TEXT). `R` accepts both INTEGER and
# REAL, which is why this one query can cover the whole (numeric-only) result
# without splitting by row the way a TEXT/BLOB-crossing one has to.
query R rowsort
SELECT v FROM mixed_where WHERE v < 'xyz'
----
1
1.5
2
2
