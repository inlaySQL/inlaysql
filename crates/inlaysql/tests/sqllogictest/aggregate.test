# Aggregate functions without GROUP BY: COUNT, SUM, MIN, MAX, AVG.

statement ok
CREATE TABLE t(a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1, 'x'), (2, 'x'), (3, 'y'), (4, NULL)

query I rowsort
SELECT COUNT(*) FROM t
----
4

query I rowsort
SELECT COUNT(b) FROM t
----
3

query I rowsort
SELECT COUNT(a) FROM t
----
4

query I rowsort
SELECT SUM(a) FROM t
----
10

query I rowsort
SELECT MIN(a) FROM t
----
1

query I rowsort
SELECT MAX(a) FROM t
----
4

query T rowsort
SELECT MIN(b) FROM t
----
x

query R rowsort
SELECT AVG(a) FROM t
----
2.5

query I rowsort
SELECT COUNT(*) FROM t WHERE a >= 3
----
2

statement error
SELECT a FROM t WHERE COUNT(*) > 1

# ------------------------------------------- MIN/MAX optimisation (AHL-546)
#
# The rewrite is invisible to SQL — same answers, fewer rows touched — so
# these pin the answers a general aggregate scan would give too. `differential.rs`
# fuzzes the two paths against each other and against sqlite3; these are the
# hand-picked edges: empty table, all-NULL indexed column, mixed NULLs,
# negative/boundary integers, TEXT/REAL under an index, WITHOUT ROWID, and an
# uncommitted write inside a transaction.

statement ok
CREATE TABLE mm(id INTEGER PRIMARY KEY, n INTEGER, s TEXT, r REAL)

statement ok
CREATE INDEX mm_n ON mm (n) USING BTREE

statement ok
CREATE INDEX mm_s ON mm (s) USING BTREE

statement ok
CREATE INDEX mm_r ON mm (r) USING BTREE

# Empty table: MIN/MAX of nothing is NULL, on the rowid and on every indexed
# column, confirmed against sqlite3.

query I nosort
SELECT MIN(id) FROM mm
----
NULL

query I nosort
SELECT MAX(id) FROM mm
----
NULL

query I nosort
SELECT MIN(n) FROM mm
----
NULL

query I nosort
SELECT MAX(n) FROM mm
----
NULL

statement ok
INSERT INTO mm VALUES (1, -5, 'banana', -2.5), (2, NULL, NULL, NULL), (3, 10, 'apple', 3.5), (4, NULL, NULL, NULL), (5, -100, 'cherry', 0.0)

# Negative and boundary integers, on the rowid and on an indexed column.

query I nosort
SELECT MIN(id) FROM mm
----
1

query I nosort
SELECT MAX(id) FROM mm
----
5

query I nosort
SELECT MIN(n) FROM mm
----
-100

query I nosort
SELECT MAX(n) FROM mm
----
10

# MIN skips NULLs; MAX of a column that has any non-NULL entry is never NULL
# just because some rows are.

query T nosort
SELECT MIN(s) FROM mm
----
apple

query T nosort
SELECT MAX(s) FROM mm
----
cherry

query R nosort
SELECT MIN(r) FROM mm
----
-2.5

query R nosort
SELECT MAX(r) FROM mm
----
3.5

# An indexed column that is NULL in every row: MIN skips every entry and
# finds nothing, MAX's plain last entry is NULL too — both answer NULL.

statement ok
CREATE TABLE all_null(id INTEGER PRIMARY KEY, n INTEGER)

statement ok
CREATE INDEX all_null_n ON all_null (n) USING BTREE

statement ok
INSERT INTO all_null VALUES (1, NULL), (2, NULL)

query I nosort
SELECT MIN(n) FROM all_null
----
NULL

query I nosort
SELECT MAX(n) FROM all_null
----
NULL

# WHERE, GROUP BY, DISTINCT and a join all still answer correctly — the
# rewrite falls back to the general path for every one of these rather than
# refusing them, and the general path is what these numbers pin.

query I nosort
SELECT MIN(n) FROM mm WHERE id > 1
----
-100

query II nosort
SELECT n, MIN(id) FROM mm GROUP BY n ORDER BY n
----
NULL 2
-100 5
-5 1
10 3

query I nosort
SELECT DISTINCT MIN(id) FROM mm
----
1

statement ok
CREATE TABLE mm_tag(mm_id INTEGER, tag TEXT)

statement ok
INSERT INTO mm_tag VALUES (1, 'x'), (3, 'y')

query I nosort
SELECT MIN(mm.id) FROM mm JOIN mm_tag ON mm_tag.mm_id = mm.id
----
1

# WITHOUT ROWID: excluded from the rewrite (`Table::without_rowid`), but the
# general path still answers it correctly.

statement ok
CREATE TABLE wr(k INTEGER, v INTEGER, PRIMARY KEY (k)) WITHOUT ROWID

statement ok
INSERT INTO wr VALUES (3, 30), (1, 10), (2, 20)

query I nosort
SELECT MIN(k) FROM wr
----
1

query I nosort
SELECT MAX(v) FROM wr
----
30

# Uncommitted writes inside a transaction: the answer reflects the pending
# insert and delete, not only what was last committed.

statement ok
BEGIN

statement ok
INSERT INTO mm VALUES (6, 500, 'zebra', 500.0)

statement ok
DELETE FROM mm WHERE id = 5

query I nosort
SELECT MAX(id) FROM mm
----
6

query I nosort
SELECT MIN(n) FROM mm
----
-5

query T nosort
SELECT MAX(s) FROM mm
----
zebra

statement ok
COMMIT

query I nosort
SELECT MAX(id) FROM mm
----
6

# A collated tie: two rows compare equal under NOCASE but differ in case.
# MAX keeps the first-seen row's casing (`AggFold::step` only replaces on a
# strictly greater comparison), which the general path already did — this
# pins the MIN/MAX optimisation's indexed path to the same tie-break rather
# than the index's own row-id order within the tied group (AHL-546 fixed a
# regression here: caught by `collated_queries_agree_with_and_without_the_index`
# in crates/inlaysql-core/tests/btree_index.rs).

statement ok
CREATE TABLE nc(id INTEGER PRIMARY KEY, s TEXT COLLATE NOCASE)

statement ok
CREATE INDEX nc_s ON nc (s) USING BTREE

statement ok
INSERT INTO nc VALUES (1, 'ada'), (2, 'Grace'), (3, 'grace'), (4, 'ADA')

query T nosort
SELECT MAX(s) FROM nc
----
Grace

query T nosort
SELECT MIN(s) FROM nc
----
ada

# ------------------------------------------- COUNT(*) optimisation (AHL-548)
#
# A bare COUNT(*) over a rowid table with nothing else in the statement is
# answered from the tree's leaf cell counts, composing with the MIN/MAX
# rewrite above so the published `COUNT(*), MIN(id), MAX(id)` shape decodes
# no row. Invisible to SQL, so these pin the answers the general path gives:
# the empty table, an open transaction with inserts, deletes and overwrites,
# a rollback, and every shape that must fall back (WHERE, COUNT(column),
# WITHOUT ROWID, a temporary table).

statement ok
CREATE TABLE cs(id INTEGER PRIMARY KEY, n INTEGER)

query I nosort
SELECT COUNT(*) FROM cs
----
0

query III nosort
SELECT COUNT(*), MIN(id), MAX(id) FROM cs
----
0 NULL NULL

statement ok
INSERT INTO cs VALUES (1, 10), (2, NULL), (3, 30), (4, NULL), (5, 50)

query I nosort
SELECT COUNT(*) FROM cs
----
5

query III nosort
SELECT COUNT(*), MIN(id), MAX(id) FROM cs
----
5 1 5

query II nosort
SELECT COUNT(*) + 1, COUNT(*) * 2 FROM cs
----
6 10

# COUNT(column) skips NULLs and is untouched by the rewrite.

query I nosort
SELECT COUNT(n) FROM cs
----
3

query II nosort
SELECT COUNT(*), COUNT(n) FROM cs
----
5 3

# WHERE falls back to the general path.

query I nosort
SELECT COUNT(*) FROM cs WHERE n IS NOT NULL
----
3

# Inside a transaction: inserts add, deletes subtract, an overwrite is not
# a row, and the count is exact before anything is committed.

statement ok
BEGIN

statement ok
INSERT INTO cs VALUES (6, 60), (7, 70), (8, 80)

query III nosort
SELECT COUNT(*), MIN(id), MAX(id) FROM cs
----
8 1 8

statement ok
DELETE FROM cs WHERE id IN (1, 7)

query III nosort
SELECT COUNT(*), MIN(id), MAX(id) FROM cs
----
6 2 8

statement ok
UPDATE cs SET n = 0 WHERE id = 3

query I nosort
SELECT COUNT(*) FROM cs
----
6

statement ok
ROLLBACK

query III nosort
SELECT COUNT(*), MIN(id), MAX(id) FROM cs
----
5 1 5

statement ok
BEGIN

statement ok
DELETE FROM cs

query III nosort
SELECT COUNT(*), MIN(id), MAX(id) FROM cs
----
0 NULL NULL

statement ok
INSERT INTO cs VALUES (9, 90)

query I nosort
SELECT COUNT(*) FROM cs
----
1

statement ok
COMMIT

query III nosort
SELECT COUNT(*), MIN(id), MAX(id) FROM cs
----
1 9 9

# WITHOUT ROWID: excluded from the rewrite, answered by the general path.

query I nosort
SELECT COUNT(*) FROM wr
----
3

# A temporary table lives on the in-memory side and is counted there.

statement ok
CREATE TEMPORARY TABLE cs_tmp(id INTEGER PRIMARY KEY)

statement ok
INSERT INTO cs_tmp VALUES (1), (2)

query I nosort
SELECT COUNT(*) FROM cs_tmp
----
2
