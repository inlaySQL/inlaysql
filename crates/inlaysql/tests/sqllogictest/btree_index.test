# Scalar B-tree indexes: the access path, the constraint, and the boundary
# cases of the memcomparable encoding as SQL sees them.
#
# Every query here is written so that the answer does not depend on the index
# existing. That is the point: the same statement against the same rows has to
# return the same thing whether it is answered from a range scan or a full one.

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER, r REAL, s TEXT)

statement ok
INSERT INTO t VALUES (1, 10, 1.5, 'apple')

statement ok
INSERT INTO t VALUES (2, 20, -0.0, 'banana')

statement ok
INSERT INTO t VALUES (3, 20, 2.5, 'apple pie')

statement ok
INSERT INTO t VALUES (4, NULL, NULL, NULL)

statement ok
INSERT INTO t VALUES (5, -7, 0.0, '')

# Built over rows that already exist.
statement ok
CREATE INDEX t_n ON t (n)

statement ok
CREATE INDEX t_r ON t (r)

# On a TEXT column the inferred kind is still the full-text index, so the
# scalar one is asked for by name.
statement ok
CREATE INDEX t_s ON t (s) USING BTREE

query I nosort
SELECT id FROM t WHERE n = 20
----
2
3

query I nosort
SELECT id FROM t WHERE n = 999
----

# The integer 20 and the real 20.0 are one key.
query I nosort
SELECT id FROM t WHERE n = 20.0
----
2
3

# -0.0 and 0.0 are one key too, so row 2 and row 5 both match.
query I nosort
SELECT id FROM t WHERE r = 0.0
----
2
5

query I nosort
SELECT id FROM t WHERE r = -0.0
----
2
5

# NULL is not equal to anything, including itself.
query I nosort
SELECT id FROM t WHERE n = NULL
----

query I nosort
SELECT id FROM t WHERE n IS NULL
----
4

query I nosort
SELECT id FROM t WHERE n > 0
----
1
2
3

query I nosort
SELECT id FROM t WHERE n >= 10 AND n < 20
----
1

query I nosort
SELECT id FROM t WHERE n BETWEEN -7 AND 10
----
1
5

query I nosort
SELECT id FROM t WHERE 20 = n
----
2
3

# The empty string sorts below everything, and a prefix sorts below the longer
# string that starts with it — row 5 is '', row 1 'apple', row 3 'apple pie',
# row 2 'banana'.
query I nosort
SELECT id FROM t WHERE s >= '' ORDER BY s, id
----
5
1
3
2

query I nosort
SELECT id FROM t WHERE s > 'apple'
----
2
3

query I nosort
SELECT id FROM t WHERE s = 'apple'
----
1

# An OR is not a conjunction: one side cannot narrow the other, and both sides'
# rows have to come back.
query I nosort
SELECT id FROM t WHERE n = 10 OR id = 4
----
1
4

# A predicate on an indexed column combined with one on an unindexed column.
query I nosort
SELECT id FROM t WHERE n = 20 AND id > 2
----
3

# Maintenance: an UPDATE moves a row's entry, a DELETE removes it.
statement ok
UPDATE t SET n = 99 WHERE id = 3

query I nosort
SELECT id FROM t WHERE n = 20
----
2

query I nosort
SELECT id FROM t WHERE n = 99
----
3

statement ok
DELETE FROM t WHERE id = 3

query I nosort
SELECT id FROM t WHERE n = 99
----

# DROP INDEX removes the entries; the answers do not change.
statement ok
DROP INDEX t_n

query I nosort
SELECT id FROM t WHERE n = 20
----
2

statement error
DROP INDEX t_n

# ---------------------------------------------------------------- multi-column

statement ok
CREATE TABLE pairs (id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO pairs VALUES (1, 1, 'x'), (2, 1, 'y'), (3, 2, 'x'), (4, NULL, 'x')

statement ok
CREATE INDEX pairs_ab ON pairs (a, b)

query I nosort
SELECT id FROM pairs WHERE a = 1 AND b = 'y'
----
2

query I nosort
SELECT id FROM pairs WHERE a = 1
----
1
2

# Only the second column is constrained, so the entries are not contiguous and
# this is a scan — with the same answer.
query I nosort
SELECT id FROM pairs WHERE b = 'x'
----
1
3
4

query I nosort
SELECT id FROM pairs WHERE a = 1 AND b > 'x'
----
2

# ---------------------------------------------------------------------- UNIQUE

statement ok
CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT)

statement ok
INSERT INTO users VALUES (1, 'a@example.com')

statement ok
CREATE UNIQUE INDEX users_email ON users (email)

statement error
INSERT INTO users VALUES (2, 'a@example.com')

statement ok
INSERT INTO users VALUES (2, 'b@example.com')

statement error
UPDATE users SET email = 'a@example.com' WHERE id = 2

# A row always collides with itself, which is not a violation.
statement ok
UPDATE users SET email = 'b@example.com' WHERE id = 2

# A NULL never collides, with anything, including another NULL.
statement ok
INSERT INTO users VALUES (3, NULL), (4, NULL)

query I nosort
SELECT COUNT(*) FROM users
----
4

query I nosort
SELECT id FROM users WHERE email = 'b@example.com'
----
2

# One name, one object: DROP INDEX takes the constraint with the index.
statement ok
DROP INDEX users_email

statement ok
INSERT INTO users VALUES (5, 'b@example.com')

# A unique index over rows that already violate it is an error, and it leaves
# the table alone.
statement error
CREATE UNIQUE INDEX users_email ON users (email)

query I nosort
SELECT COUNT(*) FROM users
----
5

# --------------------------------------------------------------- what is refused

statement ok
CREATE TABLE v (id INTEGER PRIMARY KEY, e VECTOR(2))

# A vector has no ordering, so there is no ordered index to give it.
statement error
CREATE INDEX v_e ON v (e) USING BTREE

statement error
CREATE INDEX v_e ON v (e, id)

# Structures this engine does not have are named as such rather than quietly
# turned into one it does.
statement error
CREATE INDEX t_hash ON t (n) USING HASH

statement error
CREATE INDEX t_partial ON t (n) WHERE n > 0

# Two indexes of the same kind over the same columns would be one index under
# two names.
statement ok
CREATE INDEX t_n2 ON t (n)

statement error
CREATE INDEX t_n3 ON t (n)

# A different kind on the same column is a different question, and allowed.
statement ok
CREATE INDEX t_s_ft ON t (s)

query I nosort
SELECT id FROM t WHERE n = 20
----
2
